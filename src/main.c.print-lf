#include "hardware/adc.h"

#include "tools/iesusart.h"
#include <util/delay.h>
#define LOG_LEVEL LOG_LEVEL_INFO
#include "tools/logger.h"

#include <avr/io.h>
#include <stdint.h>

int main() {
	USART_init(UBRR_SETTING);
	INFO("USART_init\n");

	ADC_init();
	ADC_init_pin(ADC_LF_RIGHT);
	ADC_init_pin(ADC_LF_MIDDLE);
	ADC_init_pin(ADC_LF_LEFT);

	while (1) {
		UI("Left  : '%d' - Middle: '%d' - Right : '%d'\n", 
				ADC_get_avg(ADC_LF_LEFT, 10),
				ADC_get_avg(ADC_LF_MIDDLE, 10),
				ADC_get_avg(ADC_LF_RIGHT, 10)
				);
		_delay_ms(10);
	}

	return 0;
}
